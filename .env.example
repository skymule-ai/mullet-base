# Use `main`, a release tag (for example v0.1.0), or a CI-generated SHA tag.
MULLET_ROS_IMAGE_TAG=main
# ROS_DOMAIN_ID is not set here: on a drone it comes from /etc/mullet/drone.env (mullet-setup). Elsewhere
# it is 0, or point at a copy: MULLET_DRONE_ENV=/path/to/drone.env
# Jetson Orin 40-pin-header UART. Uncomment/set only on Jetson hosts.
# It will be made available in the container as /dev/ttyTHS1.
# MULLET_UART_DEVICE=/dev/ttyTHS1
