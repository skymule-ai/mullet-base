# Use `main`, a release tag (for example v0.1.0), or a CI-generated SHA tag.
MULLET_ROS_IMAGE_TAG=main
ROS_DOMAIN_ID=0
# Jetson Orin 40-pin-header UART. Change only if your host exposes the UART
# under a different path; it is made available in the container as /dev/ttyTHS1.
MULLET_UART_DEVICE=/dev/ttyTHS1
